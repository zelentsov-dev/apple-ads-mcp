{
  "apiFamily": "Apple Ads Platform API",
  "apiVersion": "v1",
  "productVersion": "0.3.3",
  "legacyV5": false,
  "appleMaps": false,
  "maximumPageSize": 200,
  "maximumBulkItems": 100,
  "operations": [
    {
      "area": "access-readiness",
      "paths": ["GET /me", "GET /acls", "GET /orgs/{id}", "GET /ad-accounts/{id}", "GET /advertiser-resources"],
      "classification": "read",
      "status": "implemented"
    },
    {
      "area": "apps-metadata-eligibility",
      "paths": ["GET /search/apps", "GET /apps/{adamId}", "POST /eligibilities/apps/query", "POST /apps/{adamId}/locale-details/query", "POST /metadata/apps/supported-languages/query", "GET|POST /search/geo"],
      "classification": "read",
      "status": "implemented"
    },
    {
      "area": "diagnostics-history",
      "paths": ["POST /rejection-reasons/apps/query", "GET /rejection-reasons/apps/{id}", "POST /change-history/query", "GET /change-history/{id}", "GET /campaigns/{id}/legacy-app-limited-status-reason-details"],
      "classification": "read",
      "status": "implemented"
    },
    {
      "area": "inventory-query",
      "paths": ["POST /campaigns/query", "POST /adgroups/query", "POST /keywords/query", "POST /negative-keywords/query", "POST /ads/query", "POST /creatives/query", "POST /shared-budgets/query"],
      "classification": "read",
      "status": "implemented"
    },
    {
      "area": "suggestions-insights",
      "paths": ["POST /suggestions/categories/query", "POST /suggestions/keywords/query", "POST /suggestions/phrases/query", "POST /suggestions/target-cpas/query", "POST /insights/apps/impression-share/query", "POST /insights/apps/search-term-popularity/query"],
      "classification": "read",
      "status": "implemented",
      "knownLimitations": [
        "Apple may return HTTP 500 for documented phrase and category SUGGESTION queries",
        "Apple may return HTTP 400 for impression share on accounts without recent delivery and may omit an error code or diagnostic details; public reproductions have also reported INVALID_VALUE, but the exact prerequisite is not documented"
      ]
    },
    {
      "area": "reports",
      "paths": ["POST /reports/apps/campaigns/query", "POST /reports/apps/adgroups/query", "POST /reports/apps/ads/query", "POST /reports/apps/keywords/query", "POST /reports/apps/searchterms/query"],
      "classification": "read",
      "status": "implemented-with-typed-selectors"
    },
    {
      "area": "recommendations-read",
      "paths": ["POST /recommendations/daily-budgets/query", "POST /recommendations/target-cpas/query"],
      "classification": "read",
      "status": "implemented"
    },
    {
      "area": "optimization-read",
      "paths": ["local policy + POST /reports/apps/campaigns/query", "POST /reports/apps/adgroups/query", "POST /reports/apps/keywords/query", "POST /recommendations/daily-budgets/query", "POST /recommendations/target-cpas/query"],
      "classification": "read",
      "status": "implemented-on-demand",
      "constraints": ["maximum 20 campaigns per policy", "maximum 100 proposed actions", "no scheduler", "no automatic apply"]
    },
    {
      "area": "campaign-management",
      "paths": ["POST /campaigns", "GET /campaigns/{id}", "PUT /campaigns/{id}"],
      "classification": "mutation",
      "status": "receipt-gated"
    },
    {
      "area": "adgroup-management",
      "paths": ["POST /adgroups", "GET /adgroups/{id}", "PUT /adgroups/{id}"],
      "classification": "mutation",
      "status": "receipt-gated"
    },
    {
      "area": "keyword-management",
      "paths": ["POST /keywords", "GET /keywords/{id}", "PUT /keywords/{id}", "POST /negative-keywords", "GET /negative-keywords/{id}", "PUT /negative-keywords/{id}"],
      "classification": "mutation",
      "status": "receipt-gated"
    },
    {
      "area": "bulk-keywords",
      "paths": ["POST /keywords/bulk-create", "POST /keywords/bulk-update", "POST /negative-keywords/bulk-create", "POST /negative-keywords/bulk-update"],
      "classification": "mutation",
      "status": "receipt-gated-partial-aware"
    },
    {
      "area": "ads-creatives",
      "paths": ["POST /ads", "GET /ads/{id}", "PUT /ads/{id}", "POST /creatives", "GET /creatives/{id}", "PUT /creatives/{id}", "GET /product-pages/{id}", "POST /product-pages/query", "POST /product-pages/locale-details/query"],
      "classification": "mixed",
      "status": "implemented-placement-validated",
      "constraints": ["explicit ads are not exposed for APPSTORE_SEARCH_RESULTS", "default product page creatives are queried and reused because Apple allows one per app and ad account"]
    },
    {
      "area": "recommendation-actions",
      "paths": ["POST /recommendations/daily-budgets/apply", "POST /recommendations/daily-budgets/dismiss", "POST /recommendations/target-cpas/apply", "POST /recommendations/target-cpas/dismiss"],
      "classification": "mutation",
      "status": "receipt-gated-capped"
    },
    {
      "area": "shared-budgets",
      "paths": ["GET /shared-budgets/{id}", "POST /shared-budgets/query", "POST /shared-budgets", "PUT /shared-budgets/{id}", "PUT /campaigns/{id}"],
      "classification": "mixed",
      "status": "typed-receipt-gated",
      "constraints": ["LOC accounts only", "single explicit ad account", "private billing profile stays local", "assignment and unassignment use typed campaign updates"]
    },
    {
      "area": "optimization-apply",
      "paths": ["PUT /campaigns/{id}", "PUT /adgroups/{id}", "PUT /keywords/{id}"],
      "classification": "mutation",
      "status": "composite-receipt-gated",
      "constraints": ["maximum 20 campaigns", "maximum 100 actions", "full report and inventory drift check", "crash-durable sanitized recovery recipe", "restart-safe operations_verify", "independent confirmed 4xx may continue", "ambiguous result stops remaining actions", "no rollback or retry"]
    },
    {
      "area": "resource-lifecycle",
      "paths": ["DELETE /campaigns/{id}", "DELETE /adgroups/{id}", "DELETE /keywords/{id}", "DELETE /negative-keywords/{id}", "DELETE /ads/{id}", "DELETE /creatives/{id}", "DELETE /shared-budgets/{id}"],
      "classification": "destructive-mutation",
      "status": "separately-gated-receipt",
      "constraints": ["expected name or text", "parent campaign must be PAUSED", "bounded cascade inventory hash", "creative reference check", "Default Product Page ads and creatives return not_eligible", "shared budget assignment check", "no retry after timeout"]
    },
    {
      "area": "deferred-mutations",
      "paths": ["POST|PUT /ad-accounts", "delegation mutations", "CONTENT_PROVIDER mutations"],
      "classification": "mutation",
      "status": "not-exposed"
    }
  ]
}
